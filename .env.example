# citadel's one .env. Copy to .env (gitignored, mode 600) and fill it in. Every app reads
# this file: argus's scripts and the MCP gateway, Foundry's CLI and web server, and Pensieve
# (only the keys it uses; see apps/pensieve/scripts/root-env.sh). In the compose stack the
# same keys arrive as environment variables instead.

# ── Upstream keys. The MCP gateway holds them; a Claude session never sees them.
# SLACK_TOKEN  argus's slack-pull and the gateway's Slack server. Scopes: channels:history +
#              users:read (a user token also needs channels:read).
SLACK_TOKEN=
# LINEAR_API_KEY  the gateway's Linear server, Foundry's linear-link and Pensieve's File.
#              linear.app → Settings → Security & access → Personal API keys.
LINEAR_API_KEY=

# ── The MCP gateway (mcp-proxy on :9090, apps/argus/infra)
# MCP_GATEWAY_TOKEN  what every Claude session presents to the gateway: argus's .mcp.json
#              headersHelper, Pensieve's Ask, and Foundry's forges (as FOUNDRY_MCP_TOKEN).
MCP_GATEWAY_TOKEN=
# MCP_PORT=9090
# FOUNDRY_MCP_SERVERS=linear,slack     which upstreams a forge registers

# ── Claude
# CLAUDE_CODE_OAUTH_TOKEN  from `claude setup-token`: Foundry's forges, and in the stack the
#              sweep and Pensieve's Ask. ANTHROPIC_API_KEY bills a key instead.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# ── Foundry
# FOUNDRY_API_TOKEN  the bearer for Foundry's POST /api/jobs; Pensieve sends it.
#              `foundry auth --api` mints it.
FOUNDRY_API_TOKEN=
# FOUNDRY_URL=http://localhost:3777                                  where Pensieve reaches Foundry

# ── The stack's postgres (Foundry's database; `just db-url` prints its DATABASE_URL)
# POSTGRES_USER=foundry
# POSTGRES_PASSWORD=foundry
# POSTGRES_DB=foundry
# POSTGRES_PORT=5432
# POSTGRES_VOLUME=foundry-pgdata     the data volume; a trial stack points this elsewhere

# ── Pensieve
# WORKSPACE_DIR=      argus's data (ledgers, arch docs, state/); default ~/git/argus
# ARGUS_DIR=          argus's code; default apps/argus beside Pensieve
# PORT=3778
# PENSIEVE_HOME=      Ask's conversations; default ~/.pensieve
# FE_REPO=            product checkouts Ask reads history from;
# BE_REPO=            default ~/git/alden-portal-fe and ~/git/alden-connect-portal-be
# ASK_DEBUG=
# In the stack:
# PENSIEVE_PORT=3778                                       the host port
# PENSIEVE_FOUNDRY_URL=http://host.docker.internal:3777    Foundry, as the container reaches it
# ARGUS_DATA_DIR=~/git/argus                               argus's data, mounted at /argus-data
# FE_REPO_HOST=~/git/alden-portal-fe                       the product checkouts, read-only
# BE_REPO_HOST=~/git/alden-connect-portal-be

# ── Product repos and git
# BITBUCKET_TOKEN  read-only; the sweep container fetches the FE/BE repos and reads
#              pipelines with it.
BITBUCKET_TOKEN=
# BITBUCKET_CONFIG=   bb's credentials on a host; default ~/.bitbucket-rest-cli-config.json
# GH_TOKEN  the sweep container pushes the data repo with it.
GH_TOKEN=
