# foundry's credentials, one KEY=value per line — `foundry auth` writes them
# here (chmod 600). Copy to .env (gitignored); never commit the real file.
# The CLI, infra.sh and the web server all read this one file, fresh each time.

# Claude credential for every forge: `foundry auth` (setup-token) or `--api-key`
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# MCP gateway — what forges present to it (generated by `foundry auth --linear` / `--slack`)
# FOUNDRY_MCP_TOKEN=

# Upstream keys behind the gateway; they never enter a forge
# LINEAR_API_KEY=
# SLACK_TOKEN=

# Bearer token for POST /api/jobs, minted by `foundry auth --api`
# FOUNDRY_API_TOKEN=
