# Copy to web/.env (gitignored). `bun run infra:url` from the repo root prints
# exactly this value for whatever your infra/.env says.
DATABASE_URL=postgresql://foundry:foundry@localhost:5432/foundry

# Trigger API (POST /api/jobs) — normally minted into ~/.config/liamai/env by
# `foundry auth --api`; set here only for a headless setup without that file.
# FOUNDRY_API_TOKEN=
