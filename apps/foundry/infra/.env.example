# Copied to infra/.env on the first `bun run infra:up`. Edit that copy, not this file.
# docker compose reads it automatically; nothing here is a real secret — it is a
# throwaway local database.

POSTGRES_USER=foundry
POSTGRES_PASSWORD=foundry
POSTGRES_DB=foundry

# Host port. Point this somewhere else (5433, say) if you also run a postgres
# on the Mac itself and want both up at once.
POSTGRES_PORT=5432

# Adminer, only when started with --profile tools.
ADMINER_PORT=8081
