# derived API spec cache (1.7MB) — rebuild with `accio sync`.
# The fingerprint + meta ARE tracked, so diffs survive a fresh clone.
.state/openapi.json
# rebuilt from the frontend repo by `accio sync`; the fingerprint above is what
# needs to survive a fresh clone so spec diffs still work.
.state/accio-index.json
.state/symbols.json

# slack-digest cursor — disposable local state, digests/*.md are the record
digests/.state.json
digests/.state.next.json
# sweep step 3 drops the open-ticket titles + projects here for points.ts (repo from project, [FE]/[BE] inside Alden Portal)
.state/linear-titles.json
# slack-pull's 24h user-id → name cache
.state/slack-users.json

# TanStack AI's Claude Code adapter writes these into the cwd for one run
# (Pensieve's Ask) and removes them in its `finally`; a crash leaves them behind.
tanstack-claude-*
.tanstack-mcp-bridge-*
tanstack-output-schema-*
