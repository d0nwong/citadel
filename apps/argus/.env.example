# argus — copy to .env (gitignored). Bun loads .env from the repo root for every
# `bun …` script, so nothing here needs exporting in the shell.

# slack-digest's slack-pull.ts reads the Alden Studios Slack through this token.
# Bot or user token with channels:history + users:read (a user token also needs
# channels:read). Without it the sweep's digest tick cannot pull, and the loop runs
# on stale digests.
SLACK_TOKEN=
