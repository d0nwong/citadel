{
  "name": "pensieve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reading room for the argus blackboard — sweep reports, Slack digests, the change journal and feature docs.",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port ${PORT:-3778} --host",
    "build": "vite build",
    "start": "bun server.ts",
    "serve": "scripts/serve.sh",
    "serve:dev": "scripts/serve.sh dev",
    "unserve": "scripts/serve.sh stop",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "0.53.0",
    "@tanstack/ai-claude-code": "0.6.4",
    "@tanstack/ai-persistence": "0.5.6",
    "@tanstack/ai-react": "0.24.0",
    "@tanstack/ai-sandbox": "0.5.6",
    "@tanstack/ai-sandbox-local-process": "0.2.5",
    "@tanstack/markdown": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "yaml": "^2.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tanstack/react-ai-devtools": "^0.2.71",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-cli": "latest",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "packageManager": "bun@1.4.0"
}
