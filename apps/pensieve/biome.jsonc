{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "javascript": {
    // server.ts and the test preload run under bun; Biome does not read @types/bun.
    "globals": ["Bun"]
  },
  "linter": {
    "rules": {
      "performance": {
        // Inline handlers in JSX are the house style; none of these components are hot.
        "noJsxPropsBind": "off",
        // Server code reads the workspace sequentially on purpose (ordering, one fd at a time).
        "noAwaitInLoops": "off",
        // Regex literals in helpers are fine at this scale; hoisting hurts readability.
        "useTopLevelRegex": "off"
      },
      "complexity": {
        // `void promise` is the fire-and-forget idiom for router.invalidate() and friends.
        "noVoid": "off"
      },
      "style": {
        // Nested ternaries in JSX status switches; revisit when the components are reworked.
        "noNestedTernary": "off"
      },
      "suspicious": {
        // Without type-aware linting this flags every `str && <X/>`; nothing here renders a number.
        "noLeakedRender": "off"
      }
    }
  }
}
