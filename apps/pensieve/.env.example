# Pensieve's configuration. `./scripts/bootstrap.sh` copies this file to .env and reports
# which of the two secrets below are still missing — it never writes one. Every other value
# is optional, and an empty one means the default in the comment above it.

# Absolute path to the argus checkout (the blackboard Pensieve reads, and whose
# decisions/ it writes). Defaults to ~/git/argus when unset. In the container this is /workspace.
WORKSPACE_DIR=
PORT=3778

# Foundry, for "Send to Foundry" on the Points page. FOUNDRY_URL defaults to the dev
# server; in the container compose points it at the host. FOUNDRY_API_TOKEN is read from
# here and nowhere else: `foundry auth --api` in the Foundry repo prints one, and pasting it
# below is what Pensieve sees. Unset, Send is off and Ignore still works.
FOUNDRY_URL=http://localhost:3777
FOUNDRY_API_TOKEN=

# Linear, for File on a proposal card — the one thing Pensieve writes outside the
# blackboard. A personal API key (linear.app -> Settings -> Security & access -> Personal
# API keys); the issue is filed into the Liamai team as the key's owner. Unset, a proposal
# is still checked against the cached project list, and File reports the missing key.
LINEAR_API_KEY=

# Ask — Claude Code over the checkout. Its conversations are written under
# PENSIEVE_HOME/conversations/ (default ~/.pensieve; /data in the container), one JSON file
# per thread, and nothing is ever written into the checkout. Auth is decided per request:
# with ANTHROPIC_API_KEY set the run bills the key (the container); unset, it uses this
# machine's `claude login`. With neither, Ask is shown off with the reason.
PENSIEVE_HOME=
ANTHROPIC_API_KEY=

# The product checkouts Ask may read history from (`git -C <repo> log|show`, at the landed
# ref — never fetched or switched). Defaults are argus's: ~/git/alden-portal-fe and
# ~/git/alden-connect-portal-be. Set them where the checkouts live elsewhere.
FE_REPO=
BE_REPO=
# ASK_DEBUG=1 prints TanStack AI's full trace for every Ask run (every harness event).
# Without it, the harness's non-JSON lines are printed only when a run ends in error.
ASK_DEBUG=
